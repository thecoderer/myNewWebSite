<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Burak Görkem TUNCABAYIN | English Lessons</title>
    <meta name="description" content="A bold retro-inspired English learning website with videos, worksheets, and slides." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body class="retro-body">
    <header class="retro-header sticky top-0 z-50">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <a href="index.html" class="retro-title text-sm text-[#ffd166]">Burak Görkem</a>
        <button id="menu-btn" class="rounded-lg border border-[#ffd166]/30 p-2 text-[#fef3c7] md:hidden" aria-label="Toggle navigation">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <div id="menu" class="hidden flex-col gap-4 rounded-2xl border border-[#ffd166]/25 bg-[#1f140c]/95 p-4 text-base md:flex md:flex-row md:items-center md:gap-3 md:border-0 md:bg-transparent md:p-0">
          <a href="index.html" data-nav-link class="top-nav-link" data-i18n="nav.home">Home</a>
          <a href="gallery.html" data-nav-link class="top-nav-link" data-i18n="nav.videos">Videos</a>
          <a href="downloads.html" data-nav-link class="top-nav-link" data-i18n="nav.documents">Documents</a>
          <a href="slides.html" data-nav-link class="top-nav-link" data-i18n="nav.slides">Slides</a>
          <a href="about.html" data-nav-link class="top-nav-link" data-i18n="nav.about">About</a>
          <a href="contact.html" class="top-nav-link" data-nav-link data-i18n="nav.contact">Contact</a>
          <button id="lang-toggle" type="button" class="rounded-full border border-[#ffd166]/30 px-3 py-2 text-sm transition hover:text-[#ffd166]">TR</button>
        </div>
      </nav>
    </header>

    <main id="home" class="dashboard-shell">
      <div class="dashboard-main">
        <header class="dashboard-topbar">
          <div>
            <p class="retro-kicker" data-i18n="dashboard.kicker">Dashboard</p>
            <h1 class="dashboard-title" data-i18n="dashboard.title">Your teaching space, refined.</h1>
          </div>
          <div class="dashboard-topbar-actions">
            <a href="gallery.html" class="dashboard-pill" data-i18n="nav.videos">Video lessons</a>
            <button id="lang-toggle" type="button" class="dashboard-toggle">TR</button>
          </div>
        </header>

        <section id="overview" class="dashboard-grid dashboard-grid-hero">
          <article class="dashboard-hero-card hero-holo-card">
            <div class="hero-holo-glow"></div>
            <div>
              <p class="dashboard-eyebrow" data-i18n="dashboard.heroEyebrow">Welcome</p>
              <h2 data-i18n="dashboard.heroTitle">Clean, modern, and built for your learners.</h2>
              <p data-i18n="dashboard.heroText">A polished dashboard-style experience that keeps your lessons, worksheets, and contact details quick to find.</p>
            </div>
            <div class="dashboard-hero-actions">
              <a href="gallery.html" class="retro-btn retro-btn-primary" data-i18n="dashboard.heroCtaPrimary">Watch videos</a>
              <a href="downloads.html" class="retro-btn retro-btn-secondary" data-i18n="dashboard.heroCtaSecondary">Open documents</a>
            </div>
          </article>

          <article class="dashboard-stat-card">


          <article class="dashboard-stat-card">
            <p class="dashboard-stat-label" data-i18n="dashboard.statDocumentsLabel">Documents</p>
            <div class="dashboard-stat-value" data-i18n="dashboard.statDocumentsValue">3</div>
            <p data-i18n="dashboard.statDocumentsText">Printable materials for class use.</p>
          </article>
        </section>

        <section class="dashboard-grid dashboard-grid-cards">
          <article id="documents" class="dashboard-content-card section-card">

            <div class="retro-card-icon">📄</div>
            <h3 data-i18n="dashboard.cardDocumentsTitle">Documents</h3>
            <p data-i18n="dashboard.cardDocumentsText">Worksheets and practice sheets are grouped neatly so students can access them quickly.</p>
            <div class="dashboard-list">
              <a href="assets/worksheet-starter.txt" download><span>Starter worksheet</span><span>↓</span></a>
              <a href="assets/grammar-review.txt" download><span>Grammar review</span><span>↓</span></a>
              <a href="assets/speaking-prompts.txt" download><span>Speaking prompts</span><span>↓</span></a>
            </div>
          </article>

          <article id="about" class="dashboard-content-card section-card">
            <div class="retro-card-icon">👋</div>
            <h3 data-i18n="dashboard.cardAboutTitle">About me</h3>
            <p data-i18n="dashboard.cardAboutText">I create energetic English lessons with a clear structure, practical materials, and a friendly teaching style.</p>
          </article>

          <article id="contact" class="dashboard-content-card section-card">
            <div class="retro-card-icon">✉️</div>
            <h3 data-i18n="dashboard.cardContactTitle">Contact</h3>
            <p data-i18n="dashboard.cardContactText">Reach out for lessons, content collaboration, or classroom resources.</p>
            <div class="dashboard-actions-row">
              <a href="contact.html" class="retro-section-link" data-i18n="dashboard.cardContactLink">Contact page</a>
              <a href="https://www.youtube.com/@ingilizcederslerim" target="_blank" rel="noreferrer" class="retro-section-link" data-i18n="dashboard.cardYouTubeLink">Open YouTube</a>
            </div>
          </article>
        </section>
      </div>
    </main>

    <footer class="border-t border-[#ffd166]/20 bg-[#130d08]/80">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-8 text-base text-[#f0d79c] sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
        <p>© <span id="year"></span> Burak Görkem TUNCABAYIN. All rights reserved.</p>
        <div class="flex flex-wrap gap-4">
          <a href="mailto:hello@brightenglish.com" class="transition hover:text-[#ffd166]">hello@brightenglish.com</a>
          <a href="#videos" class="transition hover:text-[#ffd166]" data-i18n="footer.browse">Go to videos</a>
        </div>
      </div>
    </footer>

    <script src="script.js"></script>
  </body>
</html>
